{
	// Worker code, shared code, and the tests that run next to them. No DOM.
	"compilerOptions": {
		"composite": true,
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "ESNext.Disposable"],
		"types": ["./worker-configuration.d.ts", "@cloudflare/vitest-plugin/types", "vite/client"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"noUncheckedIndexedAccess": true,
		"resolveJsonModule": true
	},
	"include": ["src/worker", "src/shared", "worker-configuration.d.ts"]
}
